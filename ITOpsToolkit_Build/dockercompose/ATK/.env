# ── DNS / Domain Configuration ────────────────────────────────────────────────
DNS_NAME=docker.autonomousitopstoolkit.com

# ── PostgreSQL (Superuser & Databases) ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=itopstoolkit_maf_db

# ── Keycloak DB ───────────────────────────────────────────────────────────────
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASS=<YOUR_KEYCLOAK_DB_PASSWORD>

# ── Keycloak Admin & Realm ────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<YOUR_KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_REALM=AIOT

# ── Keycloak Client IDs & Secrets ─────────────────────────────────────────────
KEYCLOAK_BACKEND_CLIENT_ID=aiot-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=<YOUR_BACKEND_CLIENT_SECRET>
KEYCLOAK_FRONTEND_CLIENT_ID=aiot-frontend
KEYCLOAK_AGW_CLIENT_ID=agw-cli
KEYCLOAK_GRAFANA_CLIENT_ID=grafana-oAuth
KEYCLOAK_GRAFANA_CLIENT_SECRET=<YOUR_GRAFANA_CLIENT_SECRET>

# ── LiteLLM DB ────────────────────────────────────────────────────────────────
LITELLM_DB=litellm_db
LITELLM_DB_USER=litellm_user
LITELLM_DB_PASS=<YOUR_LITELLM_DB_PASSWORD>

# ── LiteLLM Proxy ─────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=<YOUR_LITELLM_MASTER_KEY>
LITELLM_UI_USERNAME=llm_user
LITELLM_UI_PASSWORD=<YOUR_LITELLM_UI_PASSWORD>

# ── Agent Gateway ─────────────────────────────────────────────────────────────
AGENT_GATEWAY_PORT=3000
AGENT_GATEWAY_ADMIN_PORT=15000
AGENT_GATEWAY_UI_PORT=19000
AGENT_GATEWAY_ADMIN_GROUP=Agentgateway-Admin

# ── ServiceNow (ITSM) ─────────────────────────────────────────────────────────
SNOW_URL=<YOUR_SERVICENOW_INSTANCE_URL>
SNOW_USER=<YOUR_SERVICENOW_USERNAME>
SNOW_PASSWORD=<YOUR_SERVICENOW_PASSWORD>
ITSM_TAG=lab_instance
ITSM_TYPE=servicenow
ITSM_AUTH_TYPE=service_account

# ── Knowledge Base (KB) Config ────────────────────────────────────────────────
KB_BASES=ITOpsToolkit, Knowledge, IT
KB_FIELDS=sys_id, number, short_description, text, kb_category, author, rating, kb_knowledge_base

# ── Service Account Credentials ───────────────────────────────────────────────
SA_CLIENT_ID=<YOUR_SERVICE_ACCOUNT_CLIENT_ID>
SA_CLIENT_SECRET=<YOUR_SERVICE_ACCOUNT_CLIENT_SECRET>

# ── MIM Assist & Communication (Optional) ─────────────────────────────────────
MIM_APP_PORT=3978
TWILIO_PHONE_NUMBER_FROM=
PROACTIVE_PROBLEM_ANALYSIS_DAYS=30

